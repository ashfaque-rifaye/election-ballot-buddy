# Election Assistant Backend - Environment Variables
# Built with Google Antigravity & Vertex AI
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Dev mode: Leave GOOGLE_CLIENT_ID empty to use dev authentication.
# The server will accept unsigned JWT tokens for local development.

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI Configuration
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-1.5-flash

# Google Cloud Storage
GCS_BUCKET_NAME=election-assistant-data

# Google Identity / OAuth (leave empty for dev mode)
GOOGLE_CLIENT_ID=

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@example.com

# Google Calendar API
GOOGLE_CALENDAR_ID=primary

# Google Maps API
GOOGLE_MAPS_API_KEY=your-maps-api-key

# Server Configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.web.app
