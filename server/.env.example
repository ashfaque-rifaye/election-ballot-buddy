# Election Assistant Backend - Environment Variables
# Built with Google Antigravity & Vertex AI
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# On Cloud Run, secrets are loaded from Google Secret Manager.
# Locally, use this .env file for development.

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI Configuration
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash

# Google Cloud Storage
GCS_BUCKET_NAME=election-assistant-data

# Google Identity / OAuth
# Leave empty for dev mode (accepts unsigned JWT tokens)
# On Cloud Run, loaded from Secret Manager
GOOGLE_CLIENT_ID=

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@example.com

# Google Calendar API
GOOGLE_CALENDAR_ID=primary

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Gemini API Key
# Create at: https://aistudio.google.com/apikey
# On Cloud Run, loaded from Secret Manager
GEMINI_API_KEY=

# Server Configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
